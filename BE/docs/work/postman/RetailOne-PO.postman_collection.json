{
  "info": {
    "name": "RetailOne PO (UC22-UC26)",
    "description": "Run in order. Fill managerUser/managerPassword/warehouseUser/warehousePassword (collection variables) with accounts created by `npm run db:seed-dev`. Never commit real passwords.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api"
    },
    {
      "key": "managerUser",
      "value": "manager"
    },
    {
      "key": "managerPassword",
      "value": ""
    },
    {
      "key": "warehouseUser",
      "value": "warehouse"
    },
    {
      "key": "warehousePassword",
      "value": ""
    },
    {
      "key": "managerToken",
      "value": ""
    },
    {
      "key": "warehouseToken",
      "value": ""
    },
    {
      "key": "supplierId",
      "value": ""
    },
    {
      "key": "variantId1",
      "value": ""
    },
    {
      "key": "variantId2",
      "value": ""
    },
    {
      "key": "poId",
      "value": ""
    },
    {
      "key": "idemKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Manager)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('login ok', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('managerToken', r.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{managerUser}}\",\n  \"password\": \"{{managerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login (Warehouse Staff)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('login ok', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('warehouseToken', r.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{warehouseUser}}\",\n  \"password\": \"{{warehousePassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{managerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "UC22 lookups",
      "item": [
        {
          "name": "Active suppliers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('supplierId', pm.response.json().data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{warehouseToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/inventory/suppliers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventory",
                "suppliers"
              ]
            }
          }
        },
        {
          "name": "Supplier catalog + supply prices",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().data.items;",
                  "pm.collectionVariables.set('variantId1', items[0].variantId);",
                  "pm.collectionVariables.set('variantId2', items[items.length-1].variantId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{warehouseToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/inventory/suppliers/{{supplierId}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventory",
                "suppliers",
                "{{supplierId}}",
                "products"
              ]
            }
          }
        },
        {
          "name": "UC22.1 suppliers for selected (low-stock) variants",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('suppliers flagged by coverage', () => pm.expect(d.suppliers.every(s => 'coversAll' in s)).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{warehouseToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/inventory/suppliers/by-variants?variantIds={{variantId1}},{{variantId2}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventory",
                "suppliers",
                "by-variants"
              ],
              "query": [
                {
                  "key": "variantIds",
                  "value": "{{variantId1}},{{variantId2}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "UC22 Create",
      "item": [
        {
          "name": "Create PO (Warehouse)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.test('PENDING', () => pm.expect(d.status).to.eql('PENDING'));",
                  "pm.collectionVariables.set('poId', d.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{warehouseToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"note\": \"optional note\",\n  \"items\": [\n    {\n      \"variantId\": \"{{variantId1}}\",\n      \"quantity\": 2,\n      \"note\": \"line note\"\n    },\n    {\n      \"variantId\": \"{{variantId2}}\",\n      \"quantity\": 3\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/inventory/purchase-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventory",
                "purchase-orders"
              ]
            }
          }
        },
        {
          "name": "Create PO - retry with the same Idempotency-Key (expect 200 replay)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('idemKey')) pm.collectionVariables.set('idemKey', 'postman-' + Date.now() + '-key');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 first, 200 on replay', () => pm.expect([200,201]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{warehouseToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"items\": [\n    {\n      \"variantId\": \"{{variantId1}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/inventory/purchase-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventory",
                "purchase-orders"
              ]
            }
          }
        },
        {
          "name": "Create PO - invalid quantity (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{warehouseToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"items\": [\n    {\n      \"variantId\": \"{{variantId1}}\",\n      \"quantity\": 1.5\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/inventory/purchase-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventory",
                "purchase-orders"
              ]
            }
          }
        }
      ]
    },
